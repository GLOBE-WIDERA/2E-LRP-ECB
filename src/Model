    }


    private void addHubsFlowE2() throws GRBException
    {
        for (Node node1: inst.getNodes())
        {
            if (node1.getType()!= Parameters.NODE_HUB)
                continue;

            Hub hub = node1.getHub();
            int j = node1.getId();
            int z = inst.getFinalNode(hub);
            int h = hub.getId();
            for (Vehicle vehicle: inst.getVehicles(2))
            {
                int k = vehicle.getId();
                //                System.out.println("int k: "+ k);
                GRBLinExpr lhs = new GRBLinExpr();
                GRBLinExpr rhs = new GRBLinExpr();

                for (Node node: inst.getNodes())
                {
                    int i = node.getId();

                    if (xijk[j][i][k] != null) {
                        lhs.addTerm(1, xijk[j][i][k]);
                    }
                    if (xijk[i][z][k] != null) {
                        rhs.addTerm(1, xijk[i][z][k]);
                    }
                }
                model.addConstr(lhs,GRB.EQUAL,rhs, "Hub_flow_E2_h_k_"+h+"_"+k);
                model.addConstr(lhs,GRB.LESS_EQUAL,qkh[k][h],"Hub_flow1_E2_h_k_"+h+"_"+k);
                model.addConstr(qkh[k][h], GRB.LESS_EQUAL,lh[h],"Vehicle_toOpen_Hub_k_h_"+k+"_"+h);
            }
        }
    }


    private void connectClientToHubVehicle() throws GRBException {

        for (Client client: inst.getClients())
        {
            int c = client.getId();

            GRBLinExpr lhs = new GRBLinExpr();
            GRBLinExpr rhs = new GRBLinExpr();
            for (Vehicle vehicle: inst.getVehicles()) {
                int k = vehicle.getId();
                if (sck[c][k] != null)
                    lhs.addTerm(1, sck[c][k]);

                for (Hub hub: inst.getHubs()) {
                    int h = hub.getId();

                    GRBLinExpr rhs1= new GRBLinExpr();
                    GRBLinExpr rhs2 = new GRBLinExpr();
                    rhs1.addConstant(1);
                    rhs2.addConstant(1);
                    if (sck[c][k] != null) {
                        if (qkh[k][h] != null && ych[c][h] != null) {
                            rhs1.addTerm(1,qkh[k][h]);
                            rhs2.addTerm(-1,qkh[k][h]);
                            rhs1.addTerm(-1,ych[c][h]);
                            rhs2.addTerm(1,ych[c][h]);
                            model.addConstr(sck[c][k], GRB.LESS_EQUAL, rhs1,
                                    "Connect_client_hub_vehicle_c_h_k_1_" + c + "_" + h + "_" + k);
                            model.addConstr(sck[c][k], GRB.LESS_EQUAL, rhs2,
                                    "Connect_client_hub_vehicle_c_h_k_2_" + c + "_" + h + "_" + k);

                        }
                    }
                }
            }
            for (Hub hub:inst.getHubs())
            {
                int h = hub.getId();
                if (ych[c][h] != null)
                    rhs.addTerm(1, ych[c][h]);
            }
            model.addConstr(lhs,GRB.EQUAL,rhs,"Client_OnlyOneVehicle_c_"+c);
        }
    }
    //constraint 20
    // for c in C, k in K, h in H : x_cik + x_zik -sch^k <= 1
    private void addConsistencyVehicleHub() throws GRBException {
        for (Node node1: inst.getNodes())
        {
            if (node1.getType() != Parameters.NODE_CLIENT)
                continue;
            int j = node1.getId();
            Client client = node1.getClient();
            int c = client.getId();
            for (Vehicle vehicle: inst.getVehicles())
            {
                int k = vehicle.getId();

                for (Node node2: inst.getNodes())
                {
                    if (node2.getType() != Parameters.NODE_HUB)
                        continue;
                    int z = node2.getId();
                    Hub hub = node2.getHub();
                    int h = hub.getId();

                    GRBLinExpr lhs = new GRBLinExpr();

                    for (Node node: inst.getNodes())
                    {
                        int i = node.getId();

                        if (xijk[j][i][k] != null)
                            lhs.addTerm(1,xijk[j][i][k]);
                        if (xijk[z][i][k] != null)
                            lhs.addTerm(1,xijk[z][i][k]);
                    }
        
                    if (sck[c][k] != null)
                        lhs.addTerm(-1,sck[c][k]);

                    model.addConstr(lhs,GRB.LESS_EQUAL,1,"Vehicle_hub_consistency_k_h_c_"+k+"_"+h+"_"+c);
                }
            }
        }
    }



    private void addHubCapacityFlow() throws GRBException
    {
        for (Node node1: inst.getNodes())
        {
            if (node1.getType() != Parameters.NODE_HUB)
                continue;

            int j = node1.getId();
            Hub hub = node1.getHub();
            int h = hub.getId();
            int finalID = inst.getFinalNode(hub);

            GRBLinExpr lhs = new GRBLinExpr();
            GRBLinExpr rhs = new GRBLinExpr();

            for (Node node2: inst.getNodes())
            {
                if (node2.getType() != Parameters.NODE_CLIENT)
                    continue;

                int i = node2.getId();
                Client client = node2.getClient();
                int c = client.getId();

                for (Vehicle vehicle: inst.getVehicles(2))
                {
                    int k = vehicle.getId();

                    if (zijk[i][finalID][k] != null && zijk[j][i][k] != null) {
                        //                        lhs.addTerm(1, zijk[i][finalID][k]);
                        lhs.addTerm(1,zijk[j][i][k]);
                    }
                }
                rhs.addTerm(client.getDemand(),ych[c][h]);
            }
            model.addConstr(lhs,GRB.EQUAL,rhs,"Hub_capacityFlow_"+h);
        }
    }

    private void addMaxCapacity() throws GRBException {
        for (Vehicle vehicle: inst.getVehicles())
        {
            int k = vehicle.getId();
            GRBLinExpr lhs = new GRBLinExpr();
            for (Node node: inst.getNodes())
            {
                int i = node.getId();

                for (Node node1: inst.getNodes())
                {
                    int j = node1.getId();
                    GRBLinExpr rhs = new GRBLinExpr();

                    if (xijk[i][j][k] != null && zijk[i][j][k] != null){
                        rhs.addTerm(vehicle.getCapacity(), xijk[i][j][k]);
                        model.addConstr(zijk[i][j][k],GRB.LESS_EQUAL,rhs,
                                "Vehicle_maxCapacity_k_i_j_"+k+"_"+i+"_"+j);
                    }
                }
            }

            for (Hub hub: inst.getHubs())
            {
                int h = hub.getId();
                if (qkh[k][h] != null)
                    lhs.addTerm(1,qkh[k][h]);
            }
            if (vehicle.getEchelon() == 2)
                model.addConstr(lhs,GRB.LESS_EQUAL,1,"Vehicle_oneHub_k_"+k);
        }
    }


