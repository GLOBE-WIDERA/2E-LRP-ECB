    private void addConstraintsPW() throws GRBException {
        for (Vehicle vehicle: inst.getVehicles(1))
        {
            int k = vehicle.getId();
            GRBLinExpr lhs = new GRBLinExpr();
            for (int i = 0; i < Parameters.INTERVALS; i++) {
                if (fke[k][i] != null) {
                    lhs.addTerm(1, fke[k][i]);
              
                }
            }
            if (Fk[k] != null)
                model.addConstr(lhs,GRB.EQUAL,Fk[k],"intervals_k_"+k);

            GRBLinExpr rhs1 = new GRBLinExpr();
            for (int i = 1; i < inst.getNumNodes(); i++) {
                for (int j = 0; j < inst.getNumNodes(); j++) {
                    if (xijk[i][j][k] != null )
                        rhs1.addTerm(1,xijk[i][j][k]);
                }
            }
            model.addConstr(Fk[k],GRB.EQUAL,rhs1,"numStops_k_"+k);
        }
    }
    private void addSymmetryBreaking() throws GRBException {

        for (int i = 0; i < inst.getVehiclesType(Parameters.VEHICLE_MED_EM).size() - 1; i++) {

            int k = inst.getVehiclesType(Parameters.VEHICLE_MED_EM).get(i).getId();
            int k1 = inst.getVehiclesType(Parameters.VEHICLE_MED_EM).get(i + 1).getId();
            GRBLinExpr lhs = new GRBLinExpr();
            GRBLinExpr rhs = new GRBLinExpr();

            for (Hub hub : inst.getHubs()) {
                int h = hub.getId();
                lhs.addTerm(1.0, qkh[k][h]);
                rhs.addTerm(1.0, qkh[k1][h]);
            }
            model.addConstr(lhs, GRB.GREATER_EQUAL, rhs, "Symmetry_k_k1_medEM_" + k + "_" + k1);
        }
        for (int i = 0; i < inst.getVehiclesType(Parameters.VEHICLE_MED_ZERO).size() - 1; i++) {

            int k = inst.getVehiclesType(Parameters.VEHICLE_MED_ZERO).get(i).getId();
            int k1 = inst.getVehiclesType(Parameters.VEHICLE_MED_ZERO).get(i + 1).getId();
            GRBLinExpr lhs = new GRBLinExpr();
            GRBLinExpr rhs = new GRBLinExpr();

            for (Hub hub : inst.getHubs()) {
                int h = hub.getId();
                lhs.addTerm(1.0, qkh[k][h]);
                rhs.addTerm(1.0, qkh[k1][h]);
            }
            model.addConstr(lhs, GRB.GREATER_EQUAL, rhs, "Symmetry_k_k1_med0_" + k + "_" + k1);
        }
        for (int i = 0; i < inst.getVehiclesType(Parameters.VEHICLE_SMALL_ZERO).size() - 1; i++) {

            int k = inst.getVehiclesType(Parameters.VEHICLE_SMALL_ZERO).get(i).getId();
            int k1 = inst.getVehiclesType(Parameters.VEHICLE_SMALL_ZERO).get(i + 1).getId();
            GRBLinExpr lhs = new GRBLinExpr();
            GRBLinExpr rhs = new GRBLinExpr();

            for (Hub hub : inst.getHubs()) {
                int h = hub.getId();
                lhs.addTerm(1.0, qkh[k][h]);
                rhs.addTerm(1.0, qkh[k1][h]);
            }
            model.addConstr(lhs, GRB.GREATER_EQUAL, rhs, "Symmetry_k_k1_small_" + k + "_" + k1);
        }


    private void addValidInequalities() throws GRBException{

        GRBLinExpr lhs = new GRBLinExpr();
        GRBLinExpr rhs = new GRBLinExpr();

        for (Hub hub: inst.getHubs()){
            lhs.addTerm(hub.getCapacity(),lh[hub.getId()]);
        }
        for (Client client: inst.getClients())
        {
            rhs.addConstant(client.getDemand());
        }

        model.addConstr(lhs,GRB.GREATER_EQUAL,rhs, "Global_Capacity_cut");


        // vehicle-hub capacity


        ArrayList<Client> clientsAtHome = new ArrayList<>();
        double demand = 0;

        for (Hub hub: inst.getHubs())
        {
            GRBLinExpr lhs2 = new GRBLinExpr();
            GRBLinExpr rhs2 = new GRBLinExpr();
            int h = hub.getId();

            for (Vehicle vehicle: inst.getVehicles(2))
            {
                int k = vehicle.getId();

                if (qkh[k][h] != null)
                    lhs2.addTerm(vehicle.getCapacity(),qkh[k][h]);
            }

            for (Client client: inst.getClients())
            {
                int c = client.getId();
                if (ych[c][h] != null)
                    rhs2.addTerm(client.getDemand(),ych[c][h]);
            }

            model.addConstr(lhs2,GRB.GREATER_EQUAL,rhs2,"Vehicle_toHub_CapacityCut_h_"+h);
        }
        for (Client client: inst.getClients())
            if (client.getEmissionProfile()[1] == 0) {
                clientsAtHome.add(client);
            }

        if (!clientsAtHome.isEmpty())
        {
            for (Client client: clientsAtHome)
                demand += client.getDemand();
            GRBLinExpr lhs3 = new GRBLinExpr();
            for (Vehicle vehicle: inst.getVehicles(2))
            {
                for (Hub hub: inst.getHubs())
                {
                    if (qkh[vehicle.getId()][hub.getId()] != null)
                        lhs3.addTerm(vehicle.getCapacity(),qkh[vehicle.getId()][hub.getId()]);
                }
            }
            model.addConstr(lhs3,GRB.GREATER_EQUAL,demand,"Subset_atHome_cut");
        }

        GRBLinExpr rhs1 = new GRBLinExpr();
        for (Vehicle vehicle: inst.getVehicles(2))
            for (Hub hub: inst.getHubs())
            {
                for (Client client: inst.getClients())
                    rhs1.addTerm(1,sck[client.getId()][vehicle.getId()]);

                model.addConstr(qkh[vehicle.getId()][hub.getId()],GRB.LESS_EQUAL,rhs1,"constraint_Attivazione_Veicolo_k_h_"+vehicle.getId()+"_"+hub.getId());
            }
    }


    private void addDepotFlow() throws GRBException {
        for (Vehicle vehicle: inst.getVehicles(1))
        {
            int k = vehicle.getId();

            GRBLinExpr lhs = new GRBLinExpr();
            GRBLinExpr rhs = new GRBLinExpr();
            for (Node node: inst.getNodes())
            {
                int i = node.getId();
                if (xijk[0][i][k] != null)
                    lhs.addTerm(1,xijk[0][i][k]);
                if (xijk[i][inst.getNumNodes()-1][k] != null)
                    rhs.addTerm(1,xijk[i][inst.getNumNodes()-1][k]);
            }
            model.addConstr(lhs,GRB.EQUAL,rhs,"Depot_flow_k_"+k);
            model.addConstr(lhs,GRB.LESS_EQUAL,1,"Depot_flow1_k_"+k);
        }
    }

    private void addSubtourElimination() throws GRBException {
        for (Vehicle vehicle: inst.getVehicles(1))
        {
            int k = vehicle.getId();
            GRBLinExpr rhs = new GRBLinExpr();
            for (Node node: inst.getNodes())
            {
                int i = node.getId();
                if (xijk[0][i][k] != null)
                    rhs.addTerm(1,xijk[0][i][k]);
            }
            for (Node node: inst.getNodes()) {
                int i = node.getId();
                for (Node node1 : inst.getNodes()) {
                    int j = node1.getId();

                    if (xijk[i][j][k] != null)
                        model.addConstr(xijk[i][j][k], GRB.LESS_EQUAL, rhs, "SubtourElimination_k_i_j_" + k + "_" + i + "_" + j);
                }
            }
        }
    }
    private void addOpeningDepot() throws GRBException
    {
        for (Node node1: inst.getNodes()) {
            if (node1.getType() != Parameters.NODE_HUB)
                continue;

            Hub hub = node1.getHub();
            int j = node1.getId();
            int h = hub.getId();

            GRBLinExpr lhs = new GRBLinExpr();
            for (Vehicle vehicle: inst.getVehicles(1))
            {
                int k = vehicle.getId();

                for (Node node: inst.getNodes())
                {
                    int i = node.getId();

                    if (xijk[j][i][k] != null) {
                        lhs.addTerm(1, xijk[j][i][k]);
                    }
                }
            }
            model.addConstr(lhs,GRB.GREATER_EQUAL,lh[h],"ArcsLeavingHub_h_"+h);
        }
        GRBLinExpr maxHubs = new GRBLinExpr();
        for (Hub hub: inst.getHubs())
        {
            int h = hub.getId();
            maxHubs.addTerm(1,lh[h]);

        }
        model.addConstr(maxHubs,GRB.LESS_EQUAL,
            problemVersion!=2?inst.getNumClients()/10.0:inst.getHubs().size(),"Max_hubs");
    }

    private void addHubsFlow() throws GRBException
    {
        for (Node node1: inst.getNodes())
        {
            if (node1.getType()!= Parameters.NODE_HUB)
                continue;

            Hub hub = node1.getHub();
            int j = node1.getId();
            int h = hub.getId();

            GRBLinExpr lhs = new GRBLinExpr();
            GRBLinExpr rhs = new GRBLinExpr();

            for (Vehicle vehicle: inst.getVehicles(1))
            {
                int k = vehicle.getId();
                //                System.out.println("int k: "+ k);

                for (Node node: inst.getNodes())
                {
                    int i = node.getId();

                    if (xijk[j][i][k] != null) {
                        lhs.addTerm(1, xijk[j][i][k]);
                    }
                    if (xijk[i][j][k] != null) {
                        rhs.addTerm(1, xijk[i][j][k]);
                    }
                }
                model.addConstr(lhs,GRB.EQUAL,rhs, "Hub_flow_h_k_"+h+"_"+k);
            }
            GRBLinExpr rhs1 = new GRBLinExpr();
            rhs1.addTerm(inst.getNumVehiclesEchelon(1),lh[h]);
            model.addConstr(lhs,GRB.LESS_EQUAL,rhs1,"Hub_activation_h_"+h);
        }
    }


    private void addHubDeliveries() throws GRBException
    {
        for (Node node1: inst.getNodes())
        {
            if (node1.getType()!= Parameters.NODE_HUB)
                continue;
            int j = node1.getId();
            Hub hub = node1.getHub();
            int h = hub.getId();

            GRBLinExpr lhs = new GRBLinExpr();
            for (Client client: inst.getClients())
            {
                int c = client.getId();

                if (wch[c][h] != null)
                    lhs.addTerm(client.getDemand(),wch[c][h]);
                if (ych[c][h] != null)
                    lhs.addTerm(client.getDemand(),ych[c][h]);
            }
            model.addConstr(lhs,GRB.LESS_EQUAL,hub.getCapacity(), "Hub_maxCapacity_h_"+h);

            GRBLinExpr rhs = new GRBLinExpr();

            for (Vehicle vehicle: inst.getVehicles(1))
            {
                int k = vehicle.getId();

                for (Node node : inst.getNodes())
                {
                    int i = node.getId();

                    if (zijk[i][j][k] != null)
                        rhs.addTerm(1,zijk[i][j][k]);
                    if (zijk[j][i][k] != null)
                        rhs.addTerm(-1,zijk[j][i][k]);

                }
            }
            model.addConstr(lhs,GRB.EQUAL,rhs,"Hub_CapacityDelivery_h_"+h);
        }
    }


    private void addDepotCapacityFlow() throws GRBException
    {
        GRBLinExpr lhs = new GRBLinExpr();
        GRBLinExpr rhs = new GRBLinExpr();
        for (Vehicle vehicle: inst.getVehicles(1))
        {
            int k = vehicle.getId();
            for (Node node : inst.getNodes())
            {
                int i = node.getId();

                if (zijk[i][0][k] != null)
                    lhs.addTerm(1,zijk[i][0][k]);
                if (zijk[0][i][k] != null)
                    lhs.addTerm(-1,zijk[0][i][k]);

            }
        }
        for (Hub hub: inst.getHubs())
        {
            int h = hub.getId();
            for (Client client: inst.getClients())
            {
                int c = client.getId();

                if (wch[c][h] != null)
                    rhs.addTerm(-client.getDemand(),wch[c][h]);
                if (ych[c][h] != null)
                    rhs.addTerm(-client.getDemand(),ych[c][h]);
            }
        }

        model.addConstr(lhs,GRB.EQUAL,rhs,"Depot_capacityFlow");
    }

    // constraints 9 - 10
    // for c in C: x_cik = x_ick = 1-w_ch
    // w_ch + y_ch = 1
    private void addClientsFlow() throws GRBException {
        for (Node node1: inst.getNodes())
        {
            if (node1.getType() != Parameters.NODE_CLIENT)
                continue;
            int j = node1.getId();

            Client client = node1.getClient();
            int c = client.getId();
            GRBLinExpr lhs = new GRBLinExpr();
            GRBLinExpr rhs = new GRBLinExpr();
            GRBLinExpr rhs1 = new GRBLinExpr();
            GRBLinExpr rhs2 = new GRBLinExpr();
            for (Hub hub: inst.getHubs())
            {
                int h = hub.getId();
                if (wch[c][h] != null) {
                    rhs1.addTerm(-1, wch[c][h]);
                    rhs2.addTerm(1,wch[c][h]);
                }
                if (ych[c][h] != null)
                    rhs2.addTerm(1,ych[c][h]);

            }
            rhs1.addConstant(1);

            for (Node node: inst.getNodes())
            {
                int i = node.getId();

                for (Vehicle vehicle: inst.getVehicles(2))
                {
                    int k = vehicle.getId();

                    if (xijk[j][i][k] != null)
                        lhs.addTerm(1,xijk[j][i][k]);
                    if (xijk[i][j][k] != null)
                        rhs.addTerm(1,xijk[i][j][k]);
                }
            }
            model.addConstr(lhs,GRB.EQUAL,rhs, "Client_flow_c_"+c);
            model.addConstr(lhs, GRB.EQUAL,rhs1, "Client_flow_home_c_"+c);
            model.addConstr(rhs2,GRB.EQUAL,1,"Client_assignment_c_"+c);

        }
    }

    //constraint 11
    // for c in C: y_ch + w_ch <= l_h
    private void addClientsToHub() throws GRBException {
        for (Client client: inst.getClients())
        {
            int c = client.getId();
            GRBLinExpr lhs = new GRBLinExpr();
            for (Hub hub:inst.getHubs())
            {
                int h = hub.getId();
                GRBLinExpr lhs1 = new GRBLinExpr();

                if (ych[c][h] != null){
                    lhs.addTerm(1,ych[c][h]);
                    lhs1.addTerm(1,ych[c][h]);
                }
                if (wch[c][h] != null){
                    lhs.addTerm(1,wch[c][h]);
                    lhs1.addTerm(1,wch[c][h]);
                }

                if (lh[h] != null)
                    model.addConstr(lhs1, GRB.LESS_EQUAL, lh[h], "Client_to_hub_c_h_" + c + "_" + h);
            }

        }
    }
    // constraint 19
    // for c in C , for k in K^2 : z_ick - z_cik = sum_ h D_c*s_ckh
    private void addClientsCapacityFlow() throws GRBException
    {
        for (Node node1 : inst.getNodes())
        {
            if (node1.getType() != Parameters.NODE_CLIENT)
