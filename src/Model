public class Model2ELRP_2I_pw {

    private Instance inst;
    private int tLim;
    private boolean relax;
    private GRBEnv env;
    private boolean callback = false;
    private GRBModel model;
    private GRBVar[][][] xijk;
    private GRBVar[][] ych;
    private GRBVar[][] wch;

    private GRBVar[][] qkh;

    private GRBVar[][] sck;
    private GRBVar[] lh;
    private GRBVar[][][] zijk;

    private GRBVar[] Fk;
    private GRBVar[][] fke;
    private GRBVar numStops;

    private double cost;

    private boolean hasSolution;
    private int problemVersion;
    private int statusOpt;


    public Model2ELRP_2I_pw(Instance inst, int tLim, boolean relax)
    {
        this.inst = inst;
        this.tLim= tLim;
        this.relax = relax;

        xijk = new GRBVar[inst.getNumNodes()][inst.getNumNodes()][inst.getNumVehicles()];
        zijk = new GRBVar[inst.getNumNodes()][inst.getNumNodes()][inst.getNumVehicles()];
        ych = new GRBVar[inst.getNumClients()][inst.getNumHubs()];
        wch = new GRBVar[inst.getNumClients()][inst.getNumHubs()];
        qkh = new GRBVar[inst.getNumVehicles()][inst.getNumHubs()];
        sck = new GRBVar[inst.getNumClients()][inst.getNumVehicles()];
        lh = new GRBVar[inst.getNumHubs()];
        Fk = new GRBVar[inst.getNumVehicles()];
        fke = new GRBVar[inst.getNumVehicles()][Parameters.INTERVALS];

    }

    public void buildModel(File solution) throws GRBException, IOException {

        env = new GRBEnv();
        setParameters();
        model = new GRBModel(env);
        addVariables();
        model.update();
        addObjective();
        addConstraintsE1();
        addConstraintsE2();
        addConstraintsPW();
        addSymmetryBreaking();
        addValidInequalities();
        model.update();
    }

    public void solve()
    {
        try
        {
            model.optimize();
            if (model.get(GRB.IntAttr.SolCount) > 0)
            {
                hasSolution = true;
            }
            int status = model.get(GRB.IntAttr.Status);
            if (status == GRB.Status.INFEASIBLE || status == GRB.Status.INF_OR_UNBD)
            {
                this.statusOpt = 2;
                printIIS();
            } else if (status == GRB.Status.TIME_LIMIT)
            {
                this.statusOpt = 1;
                if (hasSolution)
                    this.statusOpt = 4;
            } else if (status == GRB.Status.OPTIMAL)
                this.statusOpt = 0;
            else if (status == GRB.Status.CUTOFF)
                this.statusOpt = 3;
        } catch (GRBException e)
        {
            e.printStackTrace();
        }
    }

    private void printIIS() throws GRBException
    {
        // Compute IIS
        System.out.println("The model is infeasible; computing IIS");
        model.computeIIS();
        System.out.println("\nThe following constraint(s) " + "cannot be satisfied:");
        for (GRBConstr c : model.getConstrs())
        {
            if (c.get(GRB.IntAttr.IISConstr) == 1)
            {
                String constraint = c.get(GRB.StringAttr.ConstrName);
                System.out.println(constraint);
            }
        }
    }
    private void setParameters() throws GRBException {
        int threads = Runtime.getRuntime().availableProcessors();
        env.set(GRB.IntParam.Threads, threads);
        env.set(GRB.IntParam.Presolve, 1);
        env.set(GRB.DoubleParam.OptimalityTol,1e-2);
        env.set(GRB.IntParam.Method, 2);
        env.set(GRB.IntParam.PreCrush, 1);
        env.set(GRB.IntParam.NodeMethod, 1);
        env.set(GRB.IntParam.MIPFocus, 2);
        env.set(GRB.IntParam.Symmetry, 2);
        env.set(GRB.DoubleParam.MIPGap, 0);
        env.set(GRB.DoubleParam.Heuristics, 0.3);
        env.set(GRB.IntParam.OutputFlag, 1);
        env.set(GRB.IntParam.Cuts, 1);
        env.set(GRB.DoubleParam.TimeLimit, tLim);
    }

    private void addVariables() throws GRBException {
        for (Hub hub : inst.getHubs()) {
            lh[hub.getId()] = model.addVar(0, 1, 0, relax ? GRB.CONTINUOUS : GRB.BINARY,
                    "l_h_" + hub.getId());
            for (Client client : inst.getClients()) {
                ych[client.getId()][hub.getId()] = model.addVar(0, 1, 0, relax ? GRB.CONTINUOUS : GRB.BINARY,
                        "y_c_h_" + client.getId() + "_" + hub.getId());
                if (problemVersion != 2 && client.getAvailableHubs().contains(hub))
                    wch[client.getId()][hub.getId()] = model.addVar(0, 1, 0, relax ? GRB.CONTINUOUS : GRB.BINARY,
                            "w_c_h_" + client.getId() + "_" + hub.getId());
            }
            for(Vehicle vehicle: inst.getVehicles(2))
            {
                qkh[vehicle.getId()][hub.getId()] = model.addVar(0, 1, 0, relax ? GRB.CONTINUOUS : GRB.BINARY,
                        "q_k_h_" +vehicle.getId()+"_"+ hub.getId());
            }
        }

        for (Client client : inst.getClients()) {
            for (Vehicle vehicle : inst.getVehicles()) {
                if (vehicle.getEchelon() == 1)
                    continue;
                sck[client.getId()][vehicle.getId()] = model.addVar(0, 1, 0, relax ? GRB.CONTINUOUS : GRB.BINARY, "s_c_k_" + client.getId() + "_" + vehicle.getId());
            }
        }

        //variables E1
        for (Vehicle vehicle: inst.getVehicles(1))
        {

            for (int i = 0; i < inst.getNumNodes()-inst.getNumHubs()-inst.getNumClients()-1; i++) {
                Node from = inst.getNodes().get(i);

                for (int j = 1; j < inst.getNumNodes()-inst.getNumHubs()-inst.getNumClients()-1; j++) {
                    Node to = inst.getNodes().get(j);
                    if (from.equals(to))
                        continue;

                    xijk[from.getId()][to.getId()][vehicle.getId()] = model.addVar(0,1,0, relax ? GRB.CONTINUOUS : GRB.BINARY,
                            "x_e_k_i_j_"+vehicle.getEchelon()+"_"+vehicle.getId()+"_"+from.getId()+"_"+to.getId());
                    zijk[from.getId()][to.getId()][vehicle.getId()] = model.addVar(0, vehicle.getCapacity(),  0, GRB.CONTINUOUS,
                            "z_e_k_i_j_"+vehicle.getEchelon()+"_"+vehicle.getId()+"_"+from.getId()+"_"+to.getId());

                }
                if (from.getType() == Parameters.NODE_HUB)
                {
                    int finaldepot = inst.getNumNodes()-1;
                    xijk[from.getId()][finaldepot][vehicle.getId()] = model.addVar(0,1,0, relax ? GRB.CONTINUOUS : GRB.BINARY,
                            "x_e_k_i_j_"+vehicle.getEchelon()+"_"+vehicle.getId()+"_"+from.getId()+"_"+finaldepot);
                    zijk[from.getId()][finaldepot][vehicle.getId()] = model.addVar(0, 0,  0, GRB.CONTINUOUS,
                            "z_e_k_i_j_"+vehicle.getEchelon()+"_"+vehicle.getId()+"_"+from.getId()+"_"+finaldepot);
                }
            }
        }

        //variables E2

        for (int i = 1; i < inst.getNumNodes()-1-inst.getNumHubs(); i++) {

            Node from = inst.getNodes().get(i);

            for (Vehicle vehicle: inst.getVehicles(2))
            {
                for (int j = inst.getNumHubs()+1; j < inst.getNumNodes()-inst.getNumHubs()-1; j++) {
                    Node to = inst.getNodes().get(j);

                    xijk[from.getId()][to.getId()][vehicle.getId()] = model.addVar(0,1,0, relax ? GRB.CONTINUOUS : GRB.BINARY,
                            "x_e_k_i_j_"+vehicle.getEchelon()+"_"+vehicle.getId()+"_"+from.getId()+"_"+to.getId());
                    zijk[from.getId()][to.getId()][vehicle.getId()] = model.addVar(0, vehicle.getCapacity(),  0, GRB.CONTINUOUS,
                            "z_e_k_i_j_"+vehicle.getEchelon()+"_"+vehicle.getId()+"_"+from.getId()+"_"+to.getId());
                }

                if (from.getType()==Parameters.NODE_CLIENT)
                {
                    for (Hub hub: inst.getHubs())
                    {
                        int finalIndex = inst.getFinalNode(hub);

                        xijk[from.getId()][finalIndex][vehicle.getId()] = model.addVar(0,1,0, relax ? GRB.CONTINUOUS : GRB.BINARY,
                                "x_e_k_i_j_"+vehicle.getEchelon()+"_"+vehicle.getId()+"_"+from.getId()+"_"+finalIndex);
                        zijk[from.getId()][finalIndex][vehicle.getId()] = model.addVar(0, 0,  0, GRB.CONTINUOUS,
                                "z_e_k_i_j_"+vehicle.getEchelon()+"_"+vehicle.getId()+"_"+from.getId()+"_"+finalIndex);
                    }
                }
            }
        }

        for (Vehicle vehicle: inst.getVehicles(1))
        {
            int k = vehicle.getId();
            Fk[k] = model.addVar(0,GRB.INFINITY,0,GRB.INTEGER,"F_k_"+k);
            for (int i = 0; i < Parameters.INTERVALS; i++) {
                fke[k][i] = model.addVar(0,i<(Parameters.INTERVALS-1)?Parameters.INTERVALS_BOUNDS[i]:GRB.INFINITY,0,GRB.CONTINUOUS,"f_k_e_"+k+"_"+i);
            }
        }

    }

    private void addObjective() throws GRBException
    {
        GRBLinExpr obj = new GRBLinExpr();

        for (int i = 0; i < inst.getNumNodes(); i++) {
            Node n = inst.getNodes().get(i);
            for (int j = 0; j < inst.getNumNodes(); j++) {
                if (i == j)
                    continue;
                Node n1 = inst.getNodes().get(j);
                if (n.getType()== Parameters.NODE_CLIENT && n1.getType() == Parameters.NODE_HUB) {
                    if (wch[n.getClient().getId()][n1.getHub().getId()] != null) {
                        Client client = n.getClient();
                        double emission = inst.getDistances()[i][j] <= client.getEmissionProfile()[0] ? Parameters.EMISSIONS_GREEN : Parameters.EMISSIONS_PASS;
                        if (problemVersion == 1)
                            emission = 1;
                        if  (problemVersion == 5)
                            emission = 0;

                        obj.addTerm( round(emission*inst.getDistances()[i][j],0), wch[n.getClient().getId()][n1.getHub().getId()]);
                    }
                } else {
                    for (int k = 0; k < inst.getNumVehicles(); k++) {
                        Vehicle vehicle = inst.getVehicles().get(k);
                        double emissions = vehicle.getEmissions();
                        if (problemVersion == 1 || problemVersion == 5)
                            emissions = 1;
                        if (xijk[i][j][k] != null){
                            obj.addTerm( round(emissions*inst.getDistances()[i][j],0),xijk[i][j][k]);
                        }
                    }
                }
            }
        }

        if (problemVersion != 1 && problemVersion != 5) {
            //VERSIONE PIECE-WISE
            for (Vehicle vehicle : inst.getVehicles(1)) {
                int k = vehicle.getId();
                for (int i = 0; i < Parameters.INTERVALS; i++) {
                    obj.addTerm(Parameters.INTERVALS_VALUES[i], fke[k][i]);
                }
            }
        }
        model.setObjective(obj);
    }

